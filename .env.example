# Admin Control Hub - Environment Variables
# Copy this file to .env and fill in real values

ADMIN_BOT_TOKEN=your-admin-bot-token-here
ADMIN_TELEGRAM_ID=your-telegram-user-id,friends-telegram-user-id

# Optional: who receives runner alerts (crashes, restarts, daily heartbeat).
# Comma-separated subset of the admins above - lets you alert only yourself
# while everyone listed in ADMIN_TELEGRAM_ID keeps full command access.
# Leave blank to alert ALL admins.
ALERT_TELEGRAM_ID=
